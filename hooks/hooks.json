{
  "description": "Automatic Branchi capture for individually enabled local Work and Codex chats. Requires exact hook trust.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/desktop-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Updating Branchi locally"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/desktop-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Updating Branchi locally"
          }
        ]
      }
    ]
  }
}
