{
  "manifest_version": 3,
  "name": "Branchi Local Capture",
  "version": "0.14.0",
  "description": "Local visible-chat capture for individually enabled ChatGPT and Claude conversations.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "collector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
